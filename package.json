{
  "name": "biottos-finalsite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "check": "node --check src/server.js && node --check src/storefront.js && node --check src/render.js && node --check public/assets/app.js",
    "test": "node --test tests/*.test.js",
    "test:live": "node scripts/verify-shopify.js",
    "prepare": "node scripts/prepare-mosti.js"
  }
}
