{
  "name": "biottos-laedeli-preview",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": [
    "nodejs_compat",
    "enable_nodejs_http_server_modules"
  ],
  "assets": {
    "directory": "./public",
    "html_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}